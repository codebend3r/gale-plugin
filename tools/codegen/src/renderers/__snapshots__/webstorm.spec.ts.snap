"// @generated by @gale-plugin/codegen — do not edit

package com.codebend3r.gale.generated

/** Facts shared by every Gale editor plugin. */
object GaleFacts {
    const val SERVER_COMMAND = "gale"
    const val LSP_ARG = "--lsp"
    const val CONFIG_ARG = "--config"
    const val NPM_PACKAGE_NAME = "@codebend3r/gale"
    const val NPM_BIN_DIR = "bin"
    const val PACKAGE_JSON_FILE_NAME = "package.json"

    /** \`(os, arch, rust target)\` for every platform Gale publishes a binary for. */
    val PLATFORMS =
        listOf(
            Triple("darwin", "arm64", "aarch64-apple-darwin"),
            Triple("darwin", "x64", "x86_64-apple-darwin"),
            Triple("linux", "arm64", "aarch64-unknown-linux-gnu"),
            Triple("linux", "x64", "x86_64-unknown-linux-gnu"),
            Triple("win32", "x64", "x86_64-pc-windows-msvc"),
        )

    /** File extensions Gale lints, without the dot. */
    val LANGUAGE_EXTENSIONS =
        listOf(
            "css",
            "scss",
            "less",
            "sass",
        )

    /** Gale's config file names, in its priority order. */
    val CONFIG_FILE_NAMES =
        listOf(
            "gale.json",
            "gale.toml",
            ".stylelintrc",
            ".stylelintrc.json",
            ".stylelintrc.yml",
            ".stylelintrc.yaml",
            "stylelint.config.js",
            "stylelint.config.mjs",
            "stylelint.config.cjs",
            ".stylelintrc.js",
            ".stylelintrc.cjs",
            ".stylelintrc.mjs",
        )

    const val ENABLE_DEFAULT = true
    const val ENABLE_DESCRIPTION = "Enable the Gale linter."
    const val CONFIG_PATH_DEFAULT = ""
    const val CONFIG_PATH_DESCRIPTION =
        "Path to a Gale config file. Relative paths resolve from the workspace root. Leave empty to let Gale find one."
    const val BINARY_PATH_DEFAULT = ""
    const val BINARY_PATH_DESCRIPTION =
        "Absolute path to the gale binary. Leave empty to use the project's @codebend3r/gale package, then PATH."

    const val MISSING_BINARY_MESSAGE =
        "Gale couldn't find the gale binary. Install it in this project with \`bun add -d @codebend3r/gale\`, " +
            "install it globally with \`cargo install gale-lint\`, or set Settings › Tools › Gale › Binary path."
}
"
